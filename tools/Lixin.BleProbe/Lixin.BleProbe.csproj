<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Lixin.BleProbe —— P1a 能力验证工具（不是产品代码，不会打进发布包）。
    TFM 从 Directory.Build.props 继承（net9.0-windows10.0.19041.0），
    自带 WinRT 投影，因此 Windows.Devices.Bluetooth.* / GenericAttributeProfile.* 可用。
    这里不再重复声明，避免和全仓库默认值漂移。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>BleProbe</AssemblyName>
    <RootNamespace>Lixin.BleProbe</RootNamespace>
  </PropertyGroup>

</Project>
