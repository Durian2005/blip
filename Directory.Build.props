<Project>

  <!-- 全仓库共用的编译设置。单个 csproj 不要再重复声明 TargetFramework。 -->
  <PropertyGroup>
    <!--
      必须带 Windows SDK 版本号，否则没有 WinRT 投影，
      Lixin.Transport 里一行 `using Windows.Devices.Bluetooth;` 都编译不过（CS0246）。
      Lixin.Core 例外：它在自己的 csproj 里降到纯 net9.0，用来保证核心不碰任何平台 API。
    -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!--
      静态分析（对应 docs/code-review-2026-10-26.md 的 L6）：
      · AnalysisLevel=latest —— 启用全部 .NET 分析器；
      · TreatWarningsAsErrors —— 编译警告即错误，"0 警告"从人工纪律变成硬约束；
      · EnforceCodeStyleInBuild 故意保持 false —— IDE 代码风格（IDE0xxx）只在编辑器和
        `dotnet format` 里体现，不进构建。否则一次风格讨论就能让 build 挂掉，
        而风格问题不应阻断功能验证。风格基线由根目录 .editorconfig 描述。
    -->
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <!--
      公共 API 全部写了 XML 注释，打开文档文件生成让注释有产物、缺失注释有 CS1591 警告
      （配合 TreatWarningsAsErrors，漏注释会直接构建失败）。
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Version>0.1.0</Version>
    <Product>blip</Product>
    <Description>Offline P2P messenger over Bluetooth LE.</Description>
    <NeutralLanguage>en</NeutralLanguage>

    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
