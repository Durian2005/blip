<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Lixin.Core —— 纯逻辑核心，零外部依赖。
    职责：领域模型、协议帧编解码、分片/重组、IByteChannel 等接口定义。
    约束：不得引用本仓库任何其他项目；不得依赖 Windows 专有 API（保持可单测）。

    TFM 特意降到纯 net9.0（而不是全仓库默认的 net9.0-windows10.0.19041.0）：
    这样 Windows.Devices.* / System.Windows.* 在这里根本不存在，
    误用平台 API 会在编译期直接失败，比靠人记住注释可靠。
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

</Project>
